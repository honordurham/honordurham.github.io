setwd('/Users/honordurham/Documents/MEDSL/Potential Blog/wi_blog_recent')
library(dplyr)
library(tidyr)
library(ggplot2)
library(tidyverse)
library(weights)
library(car)
library(dunn.test)
library(brglm2)
options(scipen = 999)
urbanruralcodes = read.csv("UrbanInfluencecodes2024.csv") %>%
mutate(County_Name_Capitalized = toupper(County_Name), .after = County_Name) %>%
select(FIPS.UIC, State, County_Name_Capitalized, Population_2020, UIC_2024) %>%
rename(county = County_Name_Capitalized, county_population_2020 = Population_2020) %>%
mutate(close_to_metro = case_when(
UIC_2024 <= 3 ~ "Large metropolitan and adjacent counties",
UIC_2024 > 3 & UIC_2024 <=6 ~ "Small metropolitan and adjacent counties",
UIC_2024 >= 7 ~ "Not adjacent to metropolitan counties"
),
metro = case_when(
UIC_2024 == 1 | UIC_2024 == 4 ~ "Metropolitan",
UIC_2024 == 2 | UIC_2024 == 5 | UIC_2024 == 7 ~ "Micropolitan",
UIC_2024 == 3 | UIC_2024 == 6 | UIC_2024 == 8 | UIC_2024 == 9 ~ "Non-Metro/Rural"
)) %>%
rename('fips_shortened' = FIPS.UIC) %>%
mutate(close_to_metro = factor(close_to_metro,
levels = c("Large metropolitan and adjacent counties",
"Small metropolitan and adjacent counties",
"Not adjacent to metropolitan counties")))
wiurbanruralcodes = urbanruralcodes %>% filter(State == "WI")
eavs24 = read.csv("eavs24subset.csv") %>%
mutate(across(-c(FIPSCode, Jurisdiction_Name, State_Full, State_Abbr), as.numeric)) %>%
mutate(size = case_when(
total_registered_and_eligible < 1000 ~ "Small",
total_registered_and_eligible >= 1000 & total_registered_and_eligible < 50000 ~ "Medium",
total_registered_and_eligible >= 1000 ~ 'Large'
))
wi24 = eavs24 %>%
filter(State_Abbr == 'WI') %>%
mutate(county = sub(".*-\\s*", "", Jurisdiction_Name), .after = Jurisdiction_Name) %>%
left_join(wiurbanruralcodes, by = 'county') %>%
mutate(relative_size = case_when(
total_registered_and_eligible < 700 ~ "Small",
total_registered_and_eligible >= 700 & total_registered_and_eligible < 25000 ~ "Medium",
total_registered_and_eligible >= 25000 ~ 'Large'
))
write.csv(wi24, "wi24.csv")
wi24 = read.csv("wi24.csv")
#quantile(wi24$total_registered_and_eligible)
uocava = wi24 %>%
select(Jurisdiction_Name, county, uocava_transmitted, uocava_returned, uocava_undeliverable, uocava_counted, uocava_rejected, total_participants_counted, close_to_metro, metro, size, relative_size) %>%
mutate(close_to_metro = factor(close_to_metro,
levels = c("Large metropolitan and adjacent counties",
"Small metropolitan and adjacent counties",
"Not adjacent to metropolitan counties"))) %>%
mutate(uocava_rejection_rate = uocava_rejected / uocava_returned,
uocava_return_rate = uocava_returned / uocava_transmitted,
uocava_nonreturn_rate = 1 - uocava_return_rate)
