urr_relative_size = uocava %>% drop_na(uocava_rejection_rate) %>% drop_na(relative_size)
ggplot(urr_size, aes(x = size, y = uocava_rejection_rate)) +
# scale_y_log10() +
geom_boxplot() +
coord_cartesian(ylim = c(0, 1)) +
xlab("Size of Jurisdiction") +
ylab("UOCAVA rejection rate in 2024") +
theme_minimal()
ggplot(urr_size, aes(x = size, y = uocava_rejection_rate)) +
stat_summary(fun = mean, geom = "point") +
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2) +
xlab("Size of Jurisdiction") +
ylab("UOCAVA rejection rate in 2024") +
theme_minimal()
ggplot(urr_size %>% group_by(size) %>% summarize(uocava_rejection_rate = mean(uocava_rejection_rate)), aes(x = size, y = uocava_rejection_rate)) +
geom_col(fill = 'plum') +
xlab("Size of Jurisdiction") +
ylab("UOCAVA rejection rate in 2024") +
ylim(0, 0.25) +
theme_minimal()
kruskal.test(uocava_rejection_rate ~ size, data = urr_size)
dunn.test(urr_size$uocava_rejection_rate, urr_size$size, method = "bonferroni")
ggplot(urr_relative_size, aes(x = relative_size, y = uocava_rejection_rate)) +
# scale_y_log10() +
geom_boxplot() +
coord_cartesian(ylim = c(0, 1)) +
xlab("Relative Size of Jurisdiction") +
ylab("UOCAVA rejection rate in 2024") +
theme_minimal()
ggplot(urr_relative_size, aes(x = relative_size, y = uocava_rejection_rate)) +
stat_summary(fun = mean, geom = "point") +
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2) +
xlab("Relative Size of Jurisdiction") +
ylab("UOCAVA rejection rate in 2024") +
theme_minimal()
ggplot(urr_relative_size %>% group_by(relative_size) %>% summarize(uocava_rejection_rate = mean(uocava_rejection_rate)), aes(x = relative_size, y = uocava_rejection_rate)) +
geom_col(fill = 'lightblue') +
xlab("Relative Size of Jurisdiction") +
ylab("UOCAVA rejection rate in 2024") +
ylim(0, 0.25) +
theme_minimal()
kruskal.test(uocava_rejection_rate ~ relative_size, data = urr_relative_size)
dunn.test(urr_relative_size$uocava_rejection_rate, urr_relative_size$relative_size, method = "bonferroni")
